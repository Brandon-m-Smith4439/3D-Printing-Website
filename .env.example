# Local development can leave Turnstile blank. Configure real Cloudflare
# Turnstile keys before production launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Request delivery (Resend HTTP API). Leave blank during local UI testing.
RESEND_API_KEY=
REQUEST_TO_EMAIL=
REQUEST_FROM_EMAIL=

# Set this to the final HTTPS site origin in production, for example:
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Owner dashboard authentication
# Local testing can use OWNER_PASSWORD=local-owner. Use strong unique values in production.
OWNER_PASSWORD=local-owner
OWNER_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Customer profile sessions. Use a separate 32+ character random secret in production.
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Customer attachment malware scanning.
# Production customer uploads fail closed unless this is set to clamav.
CUSTOMER_UPLOAD_SCANNER=
CLAMSCAN_PATH=clamscan

# Durable application database. Defaults to data/3d-printing-business.sqlite.
# Production hosting must provide persistent private disk storage for this path.
DATABASE_PATH=

# Private customer model/image storage. Must NOT point inside public/.
# Defaults to storage/private. Customer files are only served through owner-authenticated routes.
PRIVATE_STORAGE_DIR=

# Local backup snapshots. Keep this on private persistent storage and preferably an encrypted disk/volume.
BACKUP_DIR=
BACKUP_RETAIN_COUNT=14
AUDIT_IP_SALT=

# Stripe Checkout deposit payments. Start with test-mode credentials.
# Local webhook testing: stripe listen --forward-to localhost:3000/api/payments/stripe/webhook
# Never commit real values. Use your hosting provider's secret manager in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EasyPost live carrier rates for USPS / UPS / FedEx.
# Use an EasyPost test key during development and production key when live.
EASYPOST_API_KEY=

# Private ship-from address used server-side to calculate live rates.
# This address is never sent to the public Queue.
SHIPPING_FROM_NAME=Mesh Harbor 3D
SHIPPING_FROM_STREET1=
SHIPPING_FROM_STREET2=
SHIPPING_FROM_CITY=
SHIPPING_FROM_STATE=
SHIPPING_FROM_ZIP=
SHIPPING_FROM_COUNTRY=US

# Public store URLs
NEXT_PUBLIC_ETSY_URL=https://www.etsy.com/shop/YOUR_SHOP
NEXT_PUBLIC_WHATNOT_URL=https://www.whatnot.com/user/YOUR_SHOP

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY

# Request delivery (Resend HTTP API)
RESEND_API_KEY=YOUR_RESEND_API_KEY
REQUEST_TO_EMAIL=you@example.com
REQUEST_FROM_EMAIL=Website Requests <requests@yourdomain.com>

# Optional: used for strict origin checking in production
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

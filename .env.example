# Local development can leave Turnstile blank. Configure real Cloudflare
# Turnstile keys before production launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Request delivery (Resend HTTP API). Leave blank during local UI testing.
RESEND_API_KEY=
REQUEST_TO_EMAIL=
REQUEST_FROM_EMAIL=

# Set this to the final HTTPS site origin in production, for example:
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Owner dashboard authentication
# Local testing can use OWNER_PASSWORD=local-owner. Use strong unique values in production.
OWNER_PASSWORD=local-owner
OWNER_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Customer profile sessions. Use a separate 32+ character random secret in production.
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Customer attachment malware scanning.
# Production customer uploads fail closed unless this is set to clamav.
CUSTOMER_UPLOAD_SCANNER=
CLAMSCAN_PATH=clamscan

# Durable application database. Defaults to data/3d-printing-business.sqlite locally.
# On Railway, attaching a Volume automatically sets RAILWAY_VOLUME_MOUNT_PATH and V0.74 stores
# the SQLite database, private customer files, and backups on that volume unless these are overridden.
DATABASE_PATH=

# Private customer model/image storage. Must NOT point inside public/.
# Defaults to storage/private locally or <Railway volume>/private when deployed with a Railway Volume.
PRIVATE_STORAGE_DIR=

# Local backup snapshots. Keep this on private persistent storage and preferably an encrypted disk/volume.
# Defaults to backups/ locally or <Railway volume>/backups on Railway.
BACKUP_DIR=
BACKUP_RETAIN_COUNT=14
AUDIT_IP_SALT=

# Stripe Checkout deposit payments. Start with test-mode credentials.
# Local webhook testing: stripe listen --forward-to localhost:3000/api/payments/stripe/webhook
# Never commit real values. Use your hosting provider's secret manager in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EasyPost live carrier rates for USPS / UPS / FedEx.
# Use an EasyPost test key during development and production key when live.
EASYPOST_API_KEY=
# Production EasyPost keys remain blocked until this is explicitly enabled.
# Keep false while testing and until a controlled real shipping workflow is approved.
EASYPOST_LIVE_ENABLED=false
# Secret used to validate EasyPost webhook HMAC signatures.
EASYPOST_WEBHOOK_SECRET=
# Keep automatic label buying off during test-mode validation. When enabled, moving a shipping job to Ready can buy a label.
EASYPOST_AUTO_BUY_LABELS=false
# Auto-buy pauses for owner review if current postage rises by more than the greater of these two thresholds.
EASYPOST_AUTO_BUY_MAX_INCREASE_CENTS=200
EASYPOST_AUTO_BUY_MAX_INCREASE_PERCENT=10

# The private ship-from address is configured from Owner -> Site Content in V0.74.
# It is stored in the private application database and is never exposed on the public Queue.

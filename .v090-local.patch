+
+.quote-cost-panel { display:grid; gap:14px; padding:15px; border:1px solid rgba(124,239,231,.18); border-radius:15px; background:linear-gradient(145deg,rgba(46,214,202,.045),rgba(255,255,255,.012)); min-width:0; }

+  .pricing-kpi-grid, .pricing-settings-grid { grid-template-columns:1fr; }
+  .pricing-review-backdrop { padding:10px; align-items:start; }
+  .pricing-review-modal { max-height:calc(100vh - 20px); padding:14px; border-radius:14px; }
+  .pricing-review-heading { top:-14px; margin:-14px -14px 0; padding:14px; }
+  .pricing-review-actions { bottom:-14px; margin:0 -14px -14px; padding:12px 14px 14px; }
+  .quote-cost-material-row { grid-template-columns:1fr; }
+  .quote-cost-input-grid, .quote-cost-summary { grid-template-columns:1fr 1fr; }
+  .owner-cost-closeout > summary { align-items:flex-start; flex-direction:column; }
+  .owner-cost-closeout-actions .button { flex:1 1 100%; width:100%; }
+}
+@media (max-width:430px){
+  .pricing-tabs { grid-template-columns:1fr; }
+  .quote-cost-input-grid, .quote-cost-summary { grid-template-columns:1fr; }
+  .pricing-review-lines > article { grid-template-columns:1fr; }
+  .pricing-review-actions .button { width:100%; }
+}

+.quote-cost-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
+.quote-cost-summary > div { display:grid; gap:3px; padding:9px 10px; border:1px solid rgba(107,201,202,.1); border-radius:10px; background:rgba(255,255,255,.015); min-width:0; }
